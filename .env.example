# Copy to .env (git-ignored). docker compose and local runs read it.
# Use the Neon `dev` branch connection string for the mixology database here,
# NEVER the `main` (production) branch. Never commit a real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/mixology?sslmode=require

# Optional: commit shown in the TV corner when not on Vercel
# (Vercel provides VERCEL_GIT_COMMIT_SHA automatically).
GIT_SHA=
