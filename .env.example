# Copy to .env (git-ignored). docker compose and local runs read it.
# Use the Neon `dev` branch connection string for the mixology database here,
# NEVER the `main` (production) branch. Never commit a real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/mixology?sslmode=require

# Optional: commit shown in the TV corner when not on Vercel
# (Vercel provides VERCEL_GIT_COMMIT_SHA automatically).
GIT_SHA=

# /admin: scrypt hash of the 4-digit admin PIN (never the PIN itself). Make one with
#   printf '%s' "<your PIN>" | node scripts/pin-hash.mjs
# Format scrypt:N:r:p:<salt>:<key>. Missing or malformed: /admin stays locked (fails closed).
ADMIN_PIN_HASH=
# Legacy: until it is removed, the session cookie's signing key is derived from ADMIN_PASSWORD (it no
# longer signs anyone in). Removing it, or setting SESSION_SECRET, signs every admin out once.
ADMIN_PASSWORD=
# Optional: sign admin cookies with this instead (takes priority over ADMIN_PASSWORD and ADMIN_PIN_HASH).
SESSION_SECRET=

# Optional realtime relay (relay/README.md). Both unset: pages poll exactly as before.
# RELAY_URL is the relay Worker's base URL (e.g. https://mixology-relay.<account>.workers.dev);
# RELAY_SECRET must match the Worker's RELAY_SECRET secret. Never commit a real value.
RELAY_URL=
RELAY_SECRET=
